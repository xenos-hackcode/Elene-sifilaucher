<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <!-- Full package visibility - needed for real reasons beyond just seeing the app drawer
         (which already works via the OS's separate default-launcher MAIN/LAUNCHER exemption):
         PackageInstallWatcher's PACKAGE_ADDED receiver was confirmed (via dumpsys package
         "Queries:" section and live on-device tests) to only fire for a small curated set of
         packages without this - most real new installs were invisible to it entirely, silently,
         with no crash or log to explain why. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- MyAppsScreen's install step - hands a downloaded generated-app APK to Android's own
         "install unknown app" prompt via ACTION_VIEW, the user's own explicitly chosen tap-to-
         install flow (not a silent Device Owner install). Required on API 26+ for that prompt to
         even appear when this app itself is the one launching the install intent. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Since Android 10, the incoming number passed to a call-state listener is empty without
         this too (READ_PHONE_STATE alone isn't enough) - needed for caller-ID lookup, not for
         reading call history itself. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Real evidence via `dumpsys appops`: this app's FINE_LOCATION grant is "foreground" mode
         only, but ScifiAccessibilityService's WiFi callback (NetworkHistory) fires from a
         background service context - WifiInfo stayed redacted even with NEARBY_WIFI_DEVICES
         granted until this was added too. Requesting it silently follows this same one, not
         bundled together - Android requires a separate ask for background location regardless
         of NEARBY_WIFI_DEVICES already being present. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Android 13+ (confirmed on this device: Android 16/API 36) redacts real SSID/BSSID from
         WifiInfo/NetworkCapabilities.getTransportInfo() unless the app holds this too - plain
         ACCESS_FINE_LOCATION is no longer sufficient by itself, confirmed live via a diagnostic
         log showing "<unknown ssid>"/a randomized BSSID despite location being fully granted.
         See NetworkHistory.kt / ScifiAccessibilityService's wifiNetworkCallback. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Quick Settings extra controls: eye comfort overlay, brightness slider, screen record -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Touchless gesture control: on-device hand tracking over the front camera while armed -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Lets this app prompt the system's real "ignore battery optimizations" dialog on
         behalf of a known Cedal sibling app (e.g. Cedal SMS), so it can keep running in the
         background - this only opens the standard system confirmation, never a silent grant -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Scheduled device actions ("uninstall this in 2 hours") - Device Owner apps are
         implicitly granted this, but it still needs to be declared -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Needed so NotificationListenerService can run -->
    <uses-permission
        android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!-- Cedal Shared System: signature-level permission so only apps signed with this
         same certificate can send/receive on the sync channel -->
    <permission
        android:name="com.xhacker.cedal.SHARE_SYSTEM"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.xhacker.cedal.SHARE_SYSTEM" />

    <!-- Query other launchers (for app list, etc.) and known Cedal sibling apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.xhacker.cedalmobiledev" />
        <package android:name="com.xhacker.cedalsmsrelay" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SciFiLauncher"
        android:usesCleartextTraffic="true">

        <!-- FileProvider for intruder photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- Main launcher / home activity -->
        <activity android:name=".SafetyToolsActivity" android:exported="false" />
        <activity android:name=".NetworkProtectionActivity" android:exported="false" />
        <activity android:name=".AppStarterActivity" android:exported="false" />
        <receiver android:name=".SafetyCheckInReceiver" android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SciFiLauncher">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <!-- Make this a launcher/home app -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Plain View-hosted globe isolation screen. If this renders on Samsung/One UI while
             GlobeScreen's Compose AndroidView path stays black, the failure is isolated to
             WebView surface composition inside Compose rather than Three.js/WebGL/assets. -->
        <activity
            android:name=".GlobeActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SciFiLauncher" />

        <!-- Globe wallpaper (Settings > Wallpaper > Live/Video/Image "Globe") - same reasoning as
             GlobeActivity above: a plain Activity, not Compose's AndroidView, since that path is
             confirmed to composite as solid black on this device. -->
        <activity
            android:name=".GlobeWallpaperActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SciFiLauncher" />

        <!-- Real live-GPS map ("find my current location", not the decorative Globe) - see
             MyLocationActivity for why this is a separate screen. -->
        <activity
            android:name=".MyLocationActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SciFiLauncher" />

        <!-- The Reactor - visual home for the AI (red dotted-glow-rim, reused from globe.js)
             plus a multimodal chat (text/voice/photo/image file). See XenosActivity. -->
        <activity
            android:name=".XenosActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SciFiLauncher" />

        <!-- Gesture training: lists every trainable gesture and its status -->
        <activity
            android:name=".GestureListActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SciFiLauncher" />

        <!-- Gesture training: real front-camera + hand-tracking recording screen for one
             gesture at a time -->
        <activity
            android:name=".GestureTrainingActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SciFiLauncher" />

        <!-- Dedicated host for BiometricPrompt (needs a FragmentActivity, kept isolated
             from MainActivity - see BiometricAuthActivity for why) -->
        <activity
            android:name=".BiometricAuthActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Existing lock notification listener -->
        <service
            android:name=".LockNotificationListenerService"
            android:label="SciFi Notification Filter"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Xenos notification listener -->
        <service
            android:name=".XenosNotificationListener"
            android:label="Xenos Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Xenos keyboard IME -->
        <service
            android:name=".XenosKeyboardService"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true"
            android:label="@string/xenos_keyboard_name">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/xenos_ime_config" />
        </service>

        <!-- Cedal keyboard IME -->
        <service
            android:name=".CedalKeyboardService"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true"
            android:label="@string/cedal_keyboard_name">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/cedal_ime_config" />
        </service>

        <!-- Elene's system-wide screen control (scroll/back/home/recents). android:icon makes
             the accessibility button/overlay show Elene's bubble instead of the launcher icon
             when it floats over other apps. -->
        <service
            android:name=".ScifiAccessibilityService"
            android:icon="@drawable/ic_elene_bubble"
            android:label="@string/scifi_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/scifi_accessibility_service_config" />
        </service>

        <!-- Sequence Mode: OS-level lockdown/wipe via Device Admin -->
        <receiver
            android:name=".SequenceDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Local DNS-level tracker/ad blocking (no root, no remote server) -->
        <service
            android:name=".TrackerBlockVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled local DNS tracker and advertisement filtering" />
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Real WireGuard VPN client (VpnClientActivity/WireGuardVpnManager) - GoBackend's own
             VpnService, required by the official library so it can own the tunnel lifecycle
             itself. -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <activity
            android:name=".VpnClientActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TrackerExceptionsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Eye Comfort Shield: warm-tint overlay window, real SYSTEM_ALERT_WINDOW usage
             rather than relying on an OEM night-light toggle that may not exist/enforce -->
        <service
            android:name=".EyeComfortOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="eye_comfort_screen_tint" />
        </service>

        <!-- Screen Record: MediaProjection-backed recorder, foreground service required by
             Android whenever a projection session is active. Runs in its own process - this
             API surface is finicky, and an uncaught crash in here must never be able to take
             the launcher itself down (that already happened once: an unguarded
             MediaProjection call crashed the shared process, and since this app IS the phone's
             home app, that meant no home screen until it was disabled). The startRecording()
             code is now also fully wrapped, but this is the belt-and-suspenders fix for
             whatever the next unanticipated failure mode turns out to be. -->
        <service
            android:name=".ScreenRecordService"
            android:exported="false"
            android:process=":recorder"
            android:foregroundServiceType="mediaProjection" />

        <!-- Elene's screen-perception capture box (describe_screen / play_game) - same
             :recorder process isolation as ScreenRecordService above and for the same reason. -->
        <service
            android:name=".ScreenPerceptionService"
            android:exported="false"
            android:process=":recorder"
            android:foregroundServiceType="mediaProjection" />

        <!-- Real privilege isolation, not just crash isolation like :recorder above -
             isolatedProcess="true" gives this a genuinely separate, permission-stripped UID
             with no filesystem/network access of its own. Verifies Shizuku shell commands
             before ShizukuManager ever actually executes them. -->
        <service
            android:name=".SandboxVerificationService"
            android:exported="false"
            android:process=":sandbox"
            android:isolatedProcess="true" />

        <!-- Explicit "start recording"/"stop recording" voice memo - audio-only MediaRecorder,
             no MediaProjection involved, so none of ScreenRecordService's crash-isolation
             concerns apply; runs in the main process. -->
        <service
            android:name=".VoiceMemoService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Touchless gesture control: front-camera hand tracking (MediaPipe, on-device) while
             explicitly armed from Settings - real swipe/pinch detection dispatched through
             ScifiAccessibilityService's existing gesture machinery. Only runs while armed, never
             silently. -->
        <service
            android:name=".HandGestureService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Real cellular call decline - only functional once the user grants this app
             RoleManager.ROLE_CALL_SCREENING (a real system role prompt, not something Device
             Owner can silently grant). See EleneCallScreeningService for the real, disclosed
             limitation on timing. -->
        <service
            android:name=".EleneCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Cedal Shared System: receives sync broadcasts from verified same-signature
             Cedal sibling apps only (gated by the signature-level permission above) -->
        <receiver
            android:name=".CedalSharedSystemReceiver"
            android:permission="com.xhacker.cedal.SHARE_SYSTEM"
            android:exported="true">
            <intent-filter>
                <action android:name="com.xhacker.cedal.action.SYNC" />
            </intent-filter>
        </receiver>

        <!-- New-install monitor moved to a dynamically-registered receiver on
             ScifiAccessibilityService - a manifest-declared receiver here was confirmed (via
             dumpsys activity broadcasts) to be silently skipped on this Android 16 / One UI
             build with "Background execution not allowed", the same restriction that also
             blocks Samsung's own Galaxy Store install receiver. See PackageInstallWatcher.kt. -->

        <!-- Fires scheduled device actions (delayed uninstall/download) via AlarmManager -->
        <receiver
            android:name=".ScheduledActionReceiver"
            android:exported="false" />

        <!-- Required by the Shizuku API for the separate Shizuku app to detect and bind to
             this app - standard boilerplate from Shizuku's own integration guide, not
             something that grants any access by itself. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
