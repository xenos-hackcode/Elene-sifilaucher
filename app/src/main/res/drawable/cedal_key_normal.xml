<?xml version="1.0" encoding="utf-8"?>
<!-- Cedal's own key style - neutral dark slate with a subtle border, deliberately distinct
     from Xenos's pure-black/neon-green hacker look (professional, not hacker vibe). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="#FF262B33" />
    <stroke
        android:width="1dp"
        android:color="#FF3B4150" />
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>
